@page "/"

<PageTitle>Home</PageTitle>

<div class="d-flex justify-content-center align-items-center min-vh-100">
    <div class="mx-md-5 fw-bold p-10 bg-white border-2 border-primary rounded-4 shadow-lg text-black mx-auto">
        <h1 class="text-center mt-3">Ben Car Repair Shop</h1>
        <p class="mt-5 text-break p-4">
            This is the home page of Ben Car repair shop. We specialize in all kinds of japanese and german cars. Please log in to enjoy our world class service.
        </p>
        <AuthorizeView>
            <NotAuthorized>
                <div class="d-flex justify-content-between align-items-center mt-10 p-4">
                    <a href="account/login" class="btn-link link-primary text-decoration-none link-hover-primary">Login</a>
                    <a href="account/register" class="btn-link link-primary text-decoration-none link-hover-primary">Register</a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

