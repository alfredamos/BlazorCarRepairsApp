@page "/Users/{id:guid}"

@inject IUserRepo UserRepo
@inject NavigationManager NavigationManager

@if (User == null)
{
    <p>User detail is loading...</p>
}
else
{
    <div class="row mt-5">
        <div class="col-4 mx-auto">
            <div class="card" style="width: 18rem;">
                <img src="@User.Image" class="card-img-top" alt="@User.Name">
                <div class="card-body">
                    <h5 class="card-title"><div class="d-flex justify-content-between align-content-lg-center">
                        <span>Name:</span>
                        <span> @User.Name</span>
                    </div></h5>
                    @* <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card’s content.</p> *@
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between align-content-lg-center">
                            <span>Email:</span>
                            <span> @User.Email</span>
                        </div>
                    </li>
                    <li class="list-group-item"><div class="d-flex justify-content-between align-content-lg-center">
                        <span>Phone:</span>
                        <span> @User.Phone</span>
                    </div></li>
                    <li class="list-group-item"><div class="d-flex justify-content-between align-content-lg-center">
                        <span>DOB:</span>
                        <span> @User.Birthdate.ToShortDateString()</span>
                    </div></li>
                    <li class="list-group-item"><div class="d-flex justify-content-between align-content-lg-center">
                        <span>Gender:</span>
                        <span> @User.Gender</span>
                    </div></li>
                    <li class="list-group-item"><div class="d-flex justify-content-between align-content-lg-center">
                        <span>Role:</span>
                        <span> @User.Role</span>
                    </div></li>
                </ul>
                <div class="card-body d-flex justify-content-between align-content-lg-center">
                    <button type="button" class="btn btn-link link-secondary text-decoration-none" @onclick="BackToList">Back</button>
                    <button type="button" class="btn btn-link link-danger text-decoration-none" @onclick="PrepareDelete">Delete</button>
                </div>
            </div>
        </div>    
    </div>
}

@if (_isModalOpen)
{
    <Modal ModalTitle="Delete User Dialog" 
           ModalMessage="Do you want to delete this user?" 
           BtnMessage="Delete" 
           OnCancelClick="CloseModal"
           OnDeleteClick="ConfirmDelete">
    </Modal>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private UserDto? User { get; set; }
    
    private bool _isModalOpen;
    
    private Guid _userIdToDelete;

    protected override async Task OnInitializedAsync()
    {
        User ??= await UserRepo.GetUserById(Id);
        if (User != null)
        {

            _userIdToDelete = User.Id;

        }
    }

    private void BackToList()
    {
        NavigationManager.NavigateTo("users");

    }
    
    private void PrepareDelete()
    {
        Console.WriteLine("UserDetail, user has been deleted!");
        _isModalOpen = true; // Open the modal
    }

    private void CloseModal()
    {
        _isModalOpen = false; // Close the modal
        _userIdToDelete = Guid.Empty;
    }

    private async Task ConfirmDelete()
    {
        await UserRepo.DeleteUserById(_userIdToDelete);
        
        CloseModal(); // Reset state and close
        
        NavigationManager.NavigateTo("users");
    }

}