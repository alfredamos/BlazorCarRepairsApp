@page "/users"

@inject IUserRepo UserRepo
@inject NavigationManager NavigationManager

@attribute [Authorize(Roles = Roles.Admin)]

<PageTitle>Users</PageTitle>

@if (_users is null)
{
    <p>Loading users...</p>
}
else if (!_users.Any())
{
    <p>No users found.</p>
}
else
{
    <UserTable 
        Users="_users" 
        OnChangeUserRole="ChangeUserRole"
        OnConfirmDelete="DeleteUser"
        OnDetailUser="DetailUser"
        OnGetSearchItem="GetSearchItem"
    />
}

@code {
    private List<UserDto>? _users;
    private string? _searchText;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            
            Console.WriteLine($"The value of searchItem : {_searchText}");
            _users = await UserRepo.GetAllUsers() ?? new List<UserDto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Database Error: {ex.Message}");
            
            _users = new List<UserDto>(); // Fallback to empty list to stop the loading loop
        }
    }

    private async Task ChangeUserRole(string email)
    {
        Console.WriteLine($"Change the role of user with email {email}");
        await UserRepo.ChangeUserRole(email);
        _users = await UserRepo.GetAllUsers();
    }
    
    private void DetailUser(Guid id)
    {
        NavigationManager.NavigateTo($"/users/{id}");
    }

    private async Task DeleteUser(Guid id)
    {
        await UserRepo.DeleteUserById(id);
        _users = await UserRepo.GetAllUsers(_searchText);
    }

    private async Task GetSearchItem(string query)
    {
        Console.WriteLine($"The search query : {query}");
        _searchText = query;
        
        _users = await UserRepo.GetAllUsers(query);
    }
    
}