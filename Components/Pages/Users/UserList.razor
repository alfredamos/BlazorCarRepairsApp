@page "/users"

@inject IUserRepo UserRepo
@inject NavigationManager NavigationManager

@attribute [Authorize(Roles = Roles.Admin)]

<PageTitle>Users</PageTitle>

@if (_users is null)
{
    <p>Loading users...</p>
}
else if (!_users.Any())
{
    <p>No users found.</p>
}
else
{
    <UserTable 
        Users="_users" 
        OnChangeUserRole="ChangeUserRole"
        OnConfirmDelete="DeleteUser"
        OnDetailUser="DetailUser"
        @bind-Value="_searchItem"
        @bind-Value:after="GetSearchItem"
        OnGetUserTickets="GetUserTickets"
    />
}

@code {
    private List<UserDto>? _users;
    private string _searchItem = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _users ??= await UserRepo.GetAllUsers();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Database Error: {ex.Message}");
            
            _users = []; // Fallback to empty list to stop the loading loop
        }
    }

    private async Task ChangeUserRole(string email)
    {
        Console.WriteLine($"Change the role of user with email {email}");
        await UserRepo.ChangeUserRole(email);
        _users = await UserRepo.GetAllUsers();
        StateHasChanged();
    }
    
    private void DetailUser(Guid id)
    {
        NavigationManager.NavigateTo($"/users/{id}");
    }

    private async Task DeleteUser(Guid id)
    {
        await UserRepo.DeleteUserById(id);
        _users = await UserRepo.GetAllUsers();
        StateHasChanged();
    }

    private async Task GetSearchItem()
    {
        Console.WriteLine($"The search query : {_searchItem}");
        
        _users = await UserRepo.GetAllUsers(_searchItem);
        StateHasChanged();
    }

    private void GetUserTickets((Guid userId, string userType)obj)
    {
        NavigationManager.NavigateTo(obj.userType == UserType.Customer ? $"/tickets/by-user-id/{obj.userId}" : $"/assign-tickets/by-user-id/{obj.userId}");
    }

}