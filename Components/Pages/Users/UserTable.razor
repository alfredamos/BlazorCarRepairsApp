@if (Users == null)
{
    <p><em>Loading users...</em></p>
}
else
{
    <!-- Responsive wrapper container -->
    <div class="card-header mt-2 mb-3">
        <h3 class="text-lg-center">List of Users</h3>
        <div class="d-flex align-content-center gap-2">
            <input @bind-value="_searchText" class="focus-ring-primary w-100"/>
            <button class=" btn btn-outline-primary bi-search"></button>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-striped align-middle"> 
            <thead> 
                <tr> 
                    <th scope="col">Image</th> 
                    <th scope="col">Name</th> 
                    <th scope="col">Email</th> 
                    <th scope="col">Phone</th> 
                    <th scope="col">Birthdate</th> 
                    <th scope="col">Gender</th> 
                    <th scope="col">Role</th> 
                    <th scope="col" class="text-center">Action</th> 
                </tr> 
            </thead> 
            <tbody> 
                @foreach (var user in Users) 
                { 
                    <OneUser
                        User="user"
                        OnChangeUserRole="ChangeUserRole"
                        OnDeleteUser="PrepareDelete"
                        OnDetailUser="DetailUser"
                    >
                    </OneUser>
                } 
            </tbody> 
        </table> 
    </div>
}

@if (_isModalOpen)
{
    <Modal ModalTitle="Delete User Dialog" 
           ModalMessage="Do you want to delete this user?" 
           BtnMessage="Delete" 
           OnCancelClick="CloseModal"
           OnDeleteClick="ConfirmDelete">
    </Modal>
}
@_searchText

@code {
    [Parameter] 
    public List<UserDto> Users { get; set; } = [];
    
    [Parameter] 
    public EventCallback<Guid> OnDetailUser { get; set; }
    [Parameter] 
    public EventCallback<string> OnChangeUserRole { get; set; }
    
    [Parameter]
    public EventCallback<Guid> OnConfirmDelete { get; set; }
    
    private bool _isModalOpen;
    private Guid _userIdToDelete;
    private string? _searchText;

    private async Task DetailUser(Guid id)
    {
        await OnDetailUser.InvokeAsync(id);
    }

    private async Task ChangeUserRole(string? email)
    {
        await OnChangeUserRole.InvokeAsync(email);
    }

    private void PrepareDelete(Guid userId)
    {
        _userIdToDelete = userId;
        _isModalOpen = true; // Open the modal
    }

    private void CloseModal()
    {
        _isModalOpen = false; // Close the modal
        _userIdToDelete = Guid.Empty;
    }

    private async Task ConfirmDelete()
    {
        await OnConfirmDelete.InvokeAsync(_userIdToDelete);
        
        CloseModal(); // Reset state and close
    }
}