@page "/Customers"
@inject ICustomerRepo CustomerRepo
@inject NavigationManager NavigationManager

@attribute [Authorize(Roles = Roles.Admin)]

<PageTitle>Customers</PageTitle>

@if (_customers is null)
{
    <p>Loading customers...</p>
}
else if (!_customers.Any())
{
    <div class="d-flex justify-content-between align-content-center mx-auto mb-5">
        <p>No customers found.</p>
        <button type="button" class="btn btn-outline-secondary btn-lg" @onclick="CreateNewCustomer">Add New Customer</button>
    </div>
    
}
else
{
    <CustomerTable 
        Customers="_customers" 
        OnChangeCustomerStatus="ChangeCustomerStatus"
        OnConfirmDelete="DeleteCustomer"
        OnCreateNewCustomer="CreateNewCustomer"
        OnDetailCustomer="DetailCustomer"
        OnEditCustomer="UpdateCustomer"
        OnGetSearchItem="GetSearchItem"
    />
}

@code {
    private List<CustomerResponse>? _customers;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            
            _customers ??= await CustomerRepo.GetCustomers();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Database Error: {ex.Message}");
            
            _customers = []; // Fallback to empty list to stop the loading loop
        }
    }

    private async Task ChangeCustomerStatus(Guid id)
    {
        Console.WriteLine($"At point 3 of status change, id : {id}");
        await CustomerRepo.ChangeCustomerStatus(id);
        _customers = await CustomerRepo.GetCustomers();
        StateHasChanged();
    }
    
    private void DetailCustomer(Guid id)
    {
        NavigationManager.NavigateTo($"/customers/{id}");
    }

    private async Task DeleteCustomer(Guid id)
    {
        await CustomerRepo.DeleteCustomerById(id);
        _customers = await CustomerRepo.GetCustomers();
        StateHasChanged();
    }

    private async Task GetSearchItem(string query)
    {
        Console.WriteLine($"The search query : {query}");
        
        _customers = await CustomerRepo.GetCustomers(query);
        StateHasChanged();
    }

    private void CreateNewCustomer()
    {
        NavigationManager.NavigateTo("customers/add");
    }

    private void UpdateCustomer(Guid id)
    {
        NavigationManager.NavigateTo($"customers/edit/{id}");
    }


}