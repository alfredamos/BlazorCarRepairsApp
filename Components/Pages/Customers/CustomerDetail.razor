@page "/Customers/{id:guid}"

@inject ICustomerRepo CustomerRepo
@inject NavigationManager NavigationManager

@if (Customer == null)
{
    <p>Customer detail is loading...</p>
}
else
{
    <div class="row mt-5">
        <div class="col-4 mx-auto">
            <div class="card" style="width: 18rem;">
                <div class="d-flex justify-content-between align-content-center p-2">
                    <img src="@Customer.Image" class="w-25 h-25" alt="@Customer.Name">
                    <span class="fw-bolder">@Customer.Name</span>
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between align-content-lg-center">
                            <span>Email:</span>
                            <span> @Customer.Email</span>
                        </div>
                    </li>
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between align-content-lg-center">
                            <span>Phone:</span>
                            <span> @Customer.Phone</span>
                        </div></li>
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between align-content-lg-center">
                            <span>Address:</span>
                            <span> @Customer.Address</span>
                        </div></li>
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between align-content-lg-center">
                            <span>DOB:</span>
                            <span> @Customer.Birthdate.ToShortDateString()</span>
                        </div></li>
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between align-content-lg-center">
                            <span>Gender:</span>
                            <span> @Customer.Gender</span>
                        </div></li>
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between align-content-lg-center">
                            <span>Active:</span>
                            <span> @Customer.Active</span>
                        </div></li>
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between align-content-lg-center">
                            <span>Notes:</span>
                            <span> @Customer.Notes</span>
                        </div></li>
                </ul>
                <div class="card-body d-flex justify-content-between align-content-lg-center">
                    <button type="button" class="btn btn-link link-secondary text-decoration-none link-hover-secondary fw-bold" @onclick="BackToList">Back</button>
                    <button type="button" class="btn btn-link link-danger text-decoration-none link-hover-danger fw-bold" @onclick="PrepareDelete">Delete</button>
                </div>
            </div>
        </div>    
    </div>
}

@if (_isModalOpen)
{
    <Modal ModalTitle="Delete Customer Dialog" 
           ModalMessage="Do you want to delete this Customer?" 
           BtnMessage="Delete" 
           OnCancelClick="CloseModal"
           OnDeleteClick="ConfirmDelete">
    </Modal>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private CustomerResponse? Customer { get; set; }

    private bool _isModalOpen;

    private Guid _customerIdToDelete;

    protected override async Task OnInitializedAsync()
    {
        Customer ??= await CustomerRepo.GetCustomerById(Id);
        if (Customer != null)
        {

            _customerIdToDelete = Customer.Id;

        }
    }

    private void BackToList()
    {
        NavigationManager.NavigateTo("customers");

    }

    private void PrepareDelete()
    {
        Console.WriteLine("CustomerDetail, customer has been deleted!");
        _isModalOpen = true; // Open the modal
    }

    private void CloseModal()
    {
        _isModalOpen = false; // Close the modal
        _customerIdToDelete = Guid.Empty;
    }

    private async Task ConfirmDelete()
    {
        await CustomerRepo.DeleteCustomerById(_customerIdToDelete);

        CloseModal(); // Reset state and close

        NavigationManager.NavigateTo("customers");
    }

}
