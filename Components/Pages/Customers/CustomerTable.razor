
<div class="card-header mt-2 mb-3">
    <h3 class="text-lg-center mb-2">List of Users</h3>
    <SearchBar @bind-Value:get="Value" @bind-Value:set="HandleSearchBarChanged"></SearchBar>
</div>
<!-- Responsive wrapper container -->
<div class="table-responsive">
    <table class="table table-striped align-middle"> 
        <thead> 
        <tr> 
            <th scope="col">Image</th> 
            <th scope="col">Name</th> 
            <th scope="col">Email</th> 
            <th scope="col">Phone</th> 
            <th scope="col">Address</th> 
            <th scope="col">Birthdate</th> 
            <th scope="col">Gender</th> 
            <th scope="col">Status</th>
            <th scope="col">Notes</th>
            <th scope="col" class="text-center">Action</th> 
        </tr> 
        </thead> 
        <tbody> 
        @foreach (var user in Customers) 
        { 
            <OneCustomer
                Customer="user"
                OnChangeCustomerStatus="ChangeCustomerStatus"
                OnDeleteCustomer="PrepareDelete"
                OnDetailCustomer="DetailCustomer"
                OnEditCustomer="UpdateCustomer"
                OnGetCustomerTickets="GetCustomerTickets"
            >
            </OneCustomer>
        } 
        </tbody> 
    </table> 
    <div class="d-flex justify-content-end align-content-center mb-5">
        <button type="button" class="btn btn-outline-secondary btn-lg" @onclick="CreateNewCustomer">Add new Customer</button>
    </div>
</div>

@if (_isModalOpen)
{
    <Modal ModalTitle="Delete Customer Dialog" 
           ModalMessage="Do you want to delete this customer?" 
           BtnMessage="Delete" 
           OnCancelClick="CloseModal"
           OnDeleteClick="ConfirmDelete">
    </Modal>
}

@code {
    [Parameter] public List<CustomerResponse> Customers { get; set; } = [];
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<Guid> OnDetailCustomer { get; set; }
    [Parameter] public EventCallback<Guid> OnChangeCustomerStatus { get; set; }
    [Parameter] public EventCallback<Guid> OnConfirmDelete { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public EventCallback OnCreateNewCustomer { get; set; }
    [Parameter]
    public EventCallback<Guid> OnEditCustomer {get; set; }
    
    [Parameter]
    public EventCallback<Guid> OnGetCustomerTickets {get; set; }

    private bool _isModalOpen;
    private Guid _customerIdToDelete;

    private async Task DetailCustomer(Guid id)
    {
        await OnDetailCustomer.InvokeAsync(id);
    }

    private async Task ChangeCustomerStatus(Guid id)
    {
        Console.WriteLine($"At point 2 of status change, id : {id}");
        await OnChangeCustomerStatus.InvokeAsync(id);
    }

    private void PrepareDelete(Guid id)
    {
        _customerIdToDelete = id;
        _isModalOpen = true; // Open the modal
    }

    private void CloseModal()
    {
        _isModalOpen = false; // Close the modal
        _customerIdToDelete = Guid.Empty;
    }

    private async Task ConfirmDelete()
    {
        await OnConfirmDelete.InvokeAsync(_customerIdToDelete);

        CloseModal(); // Reset state and close
    }

    private async Task CreateNewCustomer()
    {
        await OnCreateNewCustomer.InvokeAsync();
    }

    private async Task UpdateCustomer(Guid id)
    {
        await OnEditCustomer.InvokeAsync(id);
    }
    
    private async Task GetCustomerTickets(Guid customerId)
    {
        await OnGetCustomerTickets.InvokeAsync(customerId);
    }

    private async Task HandleSearchBarChanged(string newValue)
    {
        await ValueChanged.InvokeAsync(newValue);
    }

}