@if (Customers == null)
{
    <p><em>Loading customers...</em></p>
}
else
{
    <!-- Responsive wrapper container -->
    <div class="card-header mt-2 mb-3">
        <h3 class="text-lg-center mb-2">List of Customers</h3>
        <div class="d-flex align-content-center gap-2">
            <input @bind-value="SearchItem" class="form-control rounded-pill" type="search" placeholder="Search..." aria-label="Search"/>
            <button class=" btn btn-outline-primary bi-search" @onclick="GetSearchItem"></button>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-striped align-middle"> 
            <thead> 
                <tr> 
                    <th scope="col">Image</th> 
                    <th scope="col">Name</th> 
                    <th scope="col">Email</th> 
                    <th scope="col">Phone</th> 
                    <th scope="col">Address</th> 
                    <th scope="col">Birthdate</th> 
                    <th scope="col">Gender</th> 
                    <th scope="col">Status</th>
                    <th scope="col">Notes</th>
                    <th scope="col" class="text-center">Action</th> 
                </tr> 
            </thead> 
            <tbody> 
                @foreach (var user in Customers) 
                { 
                    <OneCustomer
                        Customer="user"
                        OnChangeCustomerStatus="ChangeCustomerStatus"
                        OnDeleteCustomer="PrepareDelete"
                        OnDetailCustomer="DetailCustomer"
                    >
                    </OneCustomer>
                } 
            </tbody> 
        </table> 
    </div>
}

@if (_isModalOpen)
{
    <Modal ModalTitle="Delete Customer Dialog" 
           ModalMessage="Do you want to delete this customer?" 
           BtnMessage="Delete" 
           OnCancelClick="CloseModal"
           OnDeleteClick="ConfirmDelete">
    </Modal>
}

@code {
    [Parameter] public List<CustomerResponse> Customers { get; set; } = [];
    [Parameter] public EventCallback<Guid> OnDetailCustomer { get; set; }
    [Parameter] public EventCallback<Guid> OnChangeCustomerStatus { get; set; }
    [Parameter] public EventCallback<Guid> OnConfirmDelete { get; set; }
    [Parameter] public EventCallback<string> OnGetSearchItem { get; set; }

    private bool _isModalOpen;
    private Guid _userIdToDelete;
    private string? _searchText;
    
    private string? SearchItem
    {
        get;
        set
        {
            field = value;
            _searchText = string.IsNullOrWhiteSpace(_searchText) ? value : "";
        }
    }

    private async Task DetailCustomer(Guid id)
    {
        await OnDetailCustomer.InvokeAsync(id);
    }

    private async Task ChangeCustomerStatus(Guid id)
    {
        await OnChangeCustomerStatus.InvokeAsync(id);
    }

    private void PrepareDelete(Guid userId)
    {
        _userIdToDelete = userId;
        _isModalOpen = true; // Open the modal
    }

    private void CloseModal()
    {
        _isModalOpen = false; // Close the modal
        _userIdToDelete = Guid.Empty;
    }

    private async Task ConfirmDelete()
    {
        await OnConfirmDelete.InvokeAsync(_userIdToDelete);

        CloseModal(); // Reset state and close
    }

    private async Task GetSearchItem()
    {
        await OnGetSearchItem.InvokeAsync(SearchItem);
    }
    
}