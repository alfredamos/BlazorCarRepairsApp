@page "/Tickets/{id:guid}"

@inject ITicketRepo TicketRepo
@inject NavigationManager NavigationManager

@attribute [Authorize(Roles = Roles.Admin)]

@if (Ticket == null)
{
    <p>Ticket detail is loading...</p>
}
else
{
    <div class="row mt-5">
        <div class="col-4 mx-auto">
            <div class="card" style="width: 18rem;">
                <div class="d-flex justify-content-between align-content-center p-2">
                    <img src="@Ticket.Image" class="w-25 h-25 rounded-2" alt="@Ticket.Name">
                    <span class="fw-bolder">@Ticket.Name</span>
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">
                        <div class="d-flex flex-column justify-content-between align-content-lg-center">
                            <span class="fw-bold mb-1">Title:</span>
                            <span> @Ticket.Title</span>
                        </div>
                    </li>
                    <li class="list-group-item">
                        <div class="d-flex flex-column justify-content-between align-content-lg-center">
                            <span class="fw-bold mb-1">Description:</span>
                            <span> @Ticket.Description</span>
                        </div>
                    </li>
                    <li class="list-group-item">
                        <div class="d-flex flex-column justify-content-between align-content-lg-center">
                            <span class="fw-bold mb-1">Customer:</span>
                            <span> @Ticket.Name</span>
                        </div>
                    </li>
                    <li class="list-group-item">
                        <div class="d-flex flex-column justify-content-between align-content-lg-center">
                            <span class="fw-bold mb-1">Email:</span>
                            <span> @Ticket.Email</span>
                        </div>
                    </li>
                    <li class="list-group-item">
                        <div class="d-flex flex-column justify-content-between align-content-lg-center">
                            <span class="fw-bold mb-1">Phone:</span>
                            <span> @Ticket.Phone</span>
                        </div></li>
                    <li class="list-group-item">
                        <div class="d-flex flex-column justify-content-between align-content-lg-center">
                            <span class="fw-bold mb-1">Address:</span>
                            <span> @Ticket.Address</span>
                        </div></li>
                    <li class="list-group-item">
                        <div class="d-flex flex-column justify-content-between align-content-lg-center">
                            <span class="fw-bold mb-1">Gender:</span>
                            <span> @Ticket.Gender</span>
                        </div></li>
                </ul>
                <div class="card-body d-flex justify-content-between align-content-lg-center">
                    <button type="button" class="btn btn-link link-secondary text-decoration-none link-hover-secondary fw-bold" @onclick="BackToList">Back</button>
                    <button type="button" class="btn btn-link link-danger text-decoration-none link-hover-danger fw-bold" @onclick="PrepareDelete">Delete</button>
                </div>
            </div>
        </div>    
    </div>
}

@if (_isModalOpen)
{
    <Modal ModalTitle="Delete Ticket Dialog" 
           ModalMessage="Do you want to delete this Ticket?" 
           BtnMessage="Delete" 
           OnCancelClick="CloseModal"
           OnDeleteClick="ConfirmDelete">
    </Modal>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private TicketResponse? Ticket { get; set; }

    private bool _isModalOpen;

    private Guid _ticketIdToDelete;

    protected override async Task OnInitializedAsync()
    {
        if (RendererInfo.IsInteractive)
        {
            Ticket ??= await TicketRepo.GetTicketById(Id);
            if (Ticket != null)
            {
                _ticketIdToDelete = Ticket.Id;

            }
        }
    }

    private void BackToList()
    {
        NavigationManager.NavigateTo("tickets");

    }

    private void PrepareDelete()
    {
        _isModalOpen = true; // Open the modal
    }

    private void CloseModal()
    {
        _isModalOpen = false; // Close the modal
        _ticketIdToDelete = Guid.Empty;
    }

    private async Task ConfirmDelete()
    {
        await TicketRepo.DeleteTicketById(_ticketIdToDelete);

        CloseModal(); // Reset state and close

        NavigationManager.NavigateTo("tickets");
    }

}
