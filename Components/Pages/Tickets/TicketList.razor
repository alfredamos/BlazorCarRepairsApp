@page "/Tickets"

@inject ITicketRepo TicketRepo
@inject NavigationManager NavigationManager

@attribute [Authorize(Roles = Roles.Admin)]

<PageTitle>Tickets</PageTitle>

@if (_tickets is null)
{
    <p>Loading tickets...</p>
}
else if (!_tickets.Any())
{
    <div class="d-flex justify-content-between align-content-center mx-auto mb-5">
        <p>No tickets found.</p>
        <button type="button" class="btn btn-outline-secondary btn-lg" @onclick="CreateNewTicket">Add New Ticket</button>
    </div>
    
}
else
{
    <TicketTable 
        Tickets="_tickets" 
        OnConfirmDelete="DeleteTicket"
        OnCreateNewTicket="CreateNewTicket"
        OnDetailTicket="DetailTicket"
        OnEditTicket="UpdateTicket"
        @bind-Value="_searchItem"
        @bind-Value:after="GetSearchItem"
    />
}

@code {
    private List<TicketResponse>? _tickets;
    private string _searchItem = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (RendererInfo.IsInteractive)
        {
            try
            {
                _tickets ??= await TicketRepo.GetTickets();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Database Error: {ex.Message}");

                _tickets = []; // Fallback to empty list to stop the loading loop
            }
        }
    }

    private void DetailTicket(Guid id)
    {
        NavigationManager.NavigateTo($"/tickets/{id}");
    }

    private async Task DeleteTicket(Guid id)
    {
        await TicketRepo.DeleteTicketById(id);
        _tickets = await TicketRepo.GetTickets();
        StateHasChanged();
    }

    private async Task GetSearchItem()
    {
        Console.WriteLine($"The search query : {_searchItem}");
        
        _tickets = await TicketRepo.GetTickets(_searchItem);
        StateHasChanged();
    }

    private void CreateNewTicket()
    {
        NavigationManager.NavigateTo("tickets/add");
    }

    private void UpdateTicket(Guid id)
    {
        NavigationManager.NavigateTo($"tickets/edit/{id}");
    }


}