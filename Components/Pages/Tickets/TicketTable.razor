
<!-- Responsive wrapper container -->
<div class="card-header mt-2 mb-3">
    <h3 class="text-lg-center mb-2">List of Tickets</h3>
    <div class="d-flex align-content-center gap-2">
        <input @bind-value="SearchItem" class="form-control rounded-pill" type="search" placeholder="Search..." aria-label="Search"/>
        <button class=" btn btn-outline-primary bi-search" @onclick="GetSearchItem"></button>
    </div>
</div>
<div class="table-responsive">
    <table class="table table-striped align-middle"> 
        <thead> 
        <tr> 
            <th scope="col">Image</th> 
            <th scope="col">Title</th> 
            <th scope="col">Description</th> 
            <th scope="col">Name</th> 
            <th scope="col">Email</th> 
            <th scope="col">Phone</th> 
            <th scope="col">Address</th> 
            <th scope="col">Gender</th> 
            <th scope="col" class="text-center">Action</th> 
        </tr> 
        </thead> 
        <tbody> 
        @foreach (var ticket in Tickets) 
        { 
            <OneTicket
                Ticket="ticket"
                OnDeleteTicket="PrepareDelete"
                OnDetailTicket="DetailTicket"
                OnEditTicket="UpdateTicket"
            >
            </OneTicket>
        } 
        </tbody> 
    </table> 
    <div class="d-flex justify-content-end align-content-center mb-5">
        <button type="button" class="btn btn-outline-secondary btn-lg" @onclick="CreateNewTicket">Add new Ticket</button>
    </div>
</div>

@if (_isModalOpen)
{
    <Modal ModalTitle="Delete Ticket Dialog" 
           ModalMessage="Do you want to delete this ticket?" 
           BtnMessage="Delete" 
           OnCancelClick="CloseModal"
           OnDeleteClick="ConfirmDelete">
    </Modal>
}

@code {
    [Parameter] public List<TicketResponse> Tickets { get; set; } = [];
    [Parameter] public EventCallback<Guid> OnDetailTicket { get; set; }
    [Parameter] public EventCallback<Guid> OnConfirmDelete { get; set; }
    [Parameter] public EventCallback<string> OnGetSearchItem { get; set; }
    [Parameter] public EventCallback OnCreateNewTicket { get; set; }
    [Parameter]
    public EventCallback<Guid> OnEditTicket {get; set; }

    private bool _isModalOpen;
    private Guid _ticketIdToDelete;
    private string? _searchText;
    
    private string? SearchItem
    {
        get;
        set
        {
            field = value;
            _searchText = !string.IsNullOrWhiteSpace(_searchText) ? value : "";
        }
    }

    private async Task DetailTicket(Guid id)
    {
        await OnDetailTicket.InvokeAsync(id);
    }

    private void PrepareDelete(Guid id)
    {
        _ticketIdToDelete = id;
        _isModalOpen = true; // Open the modal
    }

    private void CloseModal()
    {
        _isModalOpen = false; // Close the modal
        _ticketIdToDelete = Guid.Empty;
    }

    private async Task ConfirmDelete()
    {
        await OnConfirmDelete.InvokeAsync(_ticketIdToDelete);

        CloseModal(); // Reset state and close
    }

    private async Task GetSearchItem()
    {
        await OnGetSearchItem.InvokeAsync(SearchItem);
    }

    private async Task CreateNewTicket()
    {
        await OnCreateNewTicket.InvokeAsync();
    }

    private async Task UpdateTicket(Guid id)
    {
        await OnEditTicket.InvokeAsync(id);
    }
    
}