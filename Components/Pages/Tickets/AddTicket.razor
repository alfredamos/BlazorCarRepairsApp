@page "/tickets/add"

@inject ITicketRepo TicketRepo
@inject ICustomerRepo CustomerRepo
@inject NavigationManager NavigationManager

@attribute [Authorize(Roles = Roles.Admin)]

<PageTitle>Ticket Create Form</PageTitle>

@if (_customers is null)
{
    <p>Loading ticket create form</p>
}
else
{
    <div class="row">
    <div class="col-lg-6 mx-auto">
        <EditForm Model="Ticket" method="post" OnValidSubmit="CreateNewTicketForm" FormName="ticketCreateForm">
            <DataAnnotationsValidator />
            <h2>Create ticket form.</h2>
            <hr />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <InputText @bind-Value="Ticket.Title" id="Ticket.Title" class="form-control" autocomplete="title" aria-required="true" placeholder="Change engine oil" />
                <label for="Ticket.Title">Title</label>
                <ValidationMessage For="() => Ticket.Title" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputTextArea @bind-Value="Ticket.Description" id="Ticket.Description" class="form-control" autocomplete="description" aria-required="true" placeholder="Clean filter and change oil" />
                <label for="Ticket.Description">Description</label>
                <ValidationMessage For="() => Ticket.Description" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputSelect @bind-Value="Ticket.CustomerId" id="Ticket.CustomerId" class="form-select" autocomplete="customerId" aria-required="true" placeholder="customerId">
                    <option >Please select customer!</option>
                    @foreach (var customer in _customers)
                    {
                        <option value="@customer.Id">@customer.Name</option>
                    }
                    
                </InputSelect>
                <label for="Ticket.CustomerId">Customer</label>
                <ValidationMessage For="() => Ticket.CustomerId" class="text-danger" />
            </div>
            <div class="d-flex flex-column align-content-center gap-2">
                <button type="submit" class="w-100 btn btn-lg btn-primary">Add</button>
                <button type="button" class="w-100 btn btn-lg btn-secondary">Cancel</button>
            </div>
            
        </EditForm>
    </div>
</div>
}



@code {
    [SupplyParameterFromForm] public TicketCreateDto Ticket { get; set; } = null!;

    private List<CustomerResponse>? _customers;

    protected override async Task OnInitializedAsync()
    {
        if (RendererInfo.IsInteractive)
            _customers ??= await CustomerRepo.GetCustomers();
    }

    private async Task CreateNewTicketForm()
    {
        await TicketRepo.CreateTicket(Ticket);
        NavigationManager.NavigateTo("tickets");
        
    }
}

