<!-- Responsive wrapper container -->
<div class="card-header mt-2 mb-3">
    <h3 class="text-lg-center mb-2">List of Tickets</h3>
    <div class="d-flex align-content-center gap-2">
        <input @bind-value="SearchItem" class="form-control rounded-pill" type="search" placeholder="Search..." aria-label="Search"/>
        <button class=" btn btn-outline-primary bi-search" @onclick="GetSearchItem"></button>
    </div>
</div>
<div class="table-responsive">
    <table class="table table-striped align-middle"> 
        <thead> 
        <tr> 
            <th scope="col">Title</th> 
            <th scope="col">Description</th> 
            <th scope="col">Status</th> 
            <th scope="col">Completed</th> 
            <th scope="col">AssignBy</th> 
            <th scope="col">AssignAt</th> 
            <th scope="col">Customer name</th> 
            <th scope="col">Customer Email</th> 
            <th scope="col">Customer Phone</th> 
            <th scope="col">Customer Address</th> 
            <th scope="col">Tech Name</th> 
            <th scope="col">Tech Email</th> 
            <th scope="col">Tech Phone</th> 
            <th scope="col">Tech Specialty</th> 
            <th scope="col" class="text-center">Action</th> 
        </tr> 
        </thead> 
        <tbody> 
        @foreach (var ticket in Tickets) 
        { 
            <OneAssignedTicket
                Ticket="ticket"
                OnChangeTicketStatus="ChangeTicketStatus"
                OnDeleteTicket="PrepareDelete"
                OnDetailTicket="DetailTicket"
                OnEditTicket="UpdateTicket"
            >
            </OneAssignedTicket>
        } 
        </tbody> 
    </table> 
    <div class="d-flex justify-content-end align-content-center mb-5">
        <button type="button" class="btn btn-outline-secondary btn-lg" @onclick="CreateNewTicket">Add new Ticket</button>
    </div>
</div>

@if (_isModalOpen)
{
    <Modal ModalTitle="Delete Ticket Dialog" 
           ModalMessage="Do you want to delete this ticket?" 
           BtnMessage="Delete" 
           OnCancelClick="CloseModal"
           OnDeleteClick="ConfirmDelete">
    </Modal>
}

@code {
    [Parameter] public List<AssignedTicketResponse> Tickets { get; set; } = [];
    [Parameter] public EventCallback<(Guid TechId, Guid TicketId)> OnChangeTicketStatus { get; set; }
    [Parameter] public EventCallback<(Guid TechId, Guid TicketId)> OnDetailTicket { get; set; }
    [Parameter] public EventCallback<(Guid TechId, Guid TicketId)> OnConfirmDelete { get; set; }
    [Parameter] public EventCallback OnCreateNewTicket { get; set; }
    [Parameter]
    public EventCallback<(Guid TechId, Guid TicketId)> OnEditTicket {get; set; }
    [Parameter] public EventCallback<string> OnGetSearchItem { get; set; }
    
    private string? SearchItem
    {
        get;
        set
        {
            field = value;
            _searchText = !string.IsNullOrWhiteSpace(_searchText) ? value : "";
        }
    }

    private string? _searchText;
    private bool _isModalOpen;
    private (Guid techId, Guid ticketId )_ticketIdToDelete;
    
    private async Task ChangeTicketStatus((Guid techId, Guid ticketId) id)
    {
        await OnChangeTicketStatus.InvokeAsync((id.techId, id.ticketId));
    }
    
    private async Task DetailTicket((Guid techId, Guid ticketId) id)
    {
        await OnDetailTicket.InvokeAsync((id.techId, id.ticketId));
    }

    private void PrepareDelete((Guid techId, Guid ticketId) id)
    {
        _ticketIdToDelete = (id.techId, id.ticketId);
        _isModalOpen = true; // Open the modal
    }

    private void CloseModal()
    {
        _isModalOpen = false; // Close the modal
        _ticketIdToDelete = (Guid.Empty, Guid.Empty);
    }

    private async Task ConfirmDelete()
    {
        await OnConfirmDelete.InvokeAsync(_ticketIdToDelete);

        CloseModal(); // Reset state and close
    }

    private async Task CreateNewTicket()
    {
        await OnCreateNewTicket.InvokeAsync();
    }
    
    private async Task GetSearchItem()
    {
        await OnGetSearchItem.InvokeAsync(SearchItem);
    }

    private async Task UpdateTicket((Guid techId, Guid ticketId) id)
    {
        await OnEditTicket.InvokeAsync((id.techId, id.ticketId));
    }
    
}