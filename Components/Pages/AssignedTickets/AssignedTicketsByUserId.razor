@page "/Assign-Tickets/By-User-Id/{userId:guid}"
@using BlazorCarRepairsApp.Dto.Technicians
@using BlazorCarRepairsApp.Filters

@inject IAssignedTicketRepo ATicketRepo
@inject ITechnicianRepo TechRepo
@inject NavigationManager NavigationManager

@attribute [UserOwnerOrAdmin]

<PageTitle>Assigned Tickets</PageTitle>

@if (_tickets is null)
{
    <p>Loading tickets...</p>
}
else if (!_tickets.Any())
{
    <div class="d-flex justify-content-between align-content-center mx-auto mb-5">
        <p>No assigned tickets found.</p>
        <button type="button" class="btn btn-outline-secondary btn-lg" @onclick="CreateNewTicket">Add New Ticket</button>
    </div>
    
}
else
{
    <AssignedTicketTable 
        Tickets="_tickets" 
        OnChangeTicketStatus="ChangeTicketStatus"
        OnConfirmDelete="DeleteTicket"
        OnCreateNewTicket="CreateNewTicket"
        OnDetailTicket="DetailTicket"
        OnEditTicket="UpdateTicket"
        @bind-Value="_searchItem"
        @bind-Value:after="GetSearchItem"
    />
}

@code {
    [Parameter]
    public Guid UserId { get; set; }
    private string _searchItem = string.Empty;

    private TechResponse? _tech;
    private Guid _techId;
    
    private List<AssignedTicketResponse>? _tickets;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            
            _tech ??= await TechRepo.GetTechByUserId(UserId);
            _techId = _tech.Id;
            _tickets ??= await ATicketRepo.GetAssignedTicketsByTechnicianId(_techId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Database Error: {ex.Message}");
            
            _tickets = []; // Fallback to empty list to stop the loading loop
        }
    }

    private async Task ChangeTicketStatus((Guid techId, Guid ticketId) id)
    {
        await ATicketRepo.ChangeAssignedTicketStatus(id.techId, id.ticketId);
        _tickets = await ATicketRepo.GetAssignedTicketsByTechnicianId(_techId);
        StateHasChanged();
    }

    private void DetailTicket((Guid techId, Guid ticketId) id)
    {
        NavigationManager.NavigateTo($"/assign-tickets/{id.techId}/{id.ticketId}");
    }

    private async Task DeleteTicket((Guid techId, Guid ticketId) id)
    {
        await ATicketRepo.DeleteAssignedTicketById(id.techId,  id.ticketId);
        _tickets = await ATicketRepo.GetAssignedTicketsByTechnicianId(_techId);
        StateHasChanged();
    }
    
    private async Task GetSearchItem()
    {
        Console.WriteLine($"The search query : {_searchItem}");
        
        _tickets = await ATicketRepo.GetAssignedTicketsByTechnicianId(_techId, _searchItem);
        StateHasChanged();
    }

    private void CreateNewTicket()
    {
        NavigationManager.NavigateTo("assign-tickets/add");
    }

    private void UpdateTicket((Guid techId, Guid ticketId) id)
    {
        NavigationManager.NavigateTo($"assign-tickets/edit/{id.techId}/{id.ticketId}");
    }


}