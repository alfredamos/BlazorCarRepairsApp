@page "/Assign-Tickets/{techId:guid}/{ticketId:guid}"
@using BlazorCarRepairsApp.Filters

@inject IAssignedTicketRepo TicketRepo
@inject NavigationManager NavigationManager

@attribute [TechnicianOwnerOrAdmin]

@if (_ticket is null)
{
    <p>Assigned Ticket detail is loading...</p>
}
else
{

    <div class="card mb-3 mx-auto" style="max-width:700px;">
        <div class="row g-0">
            <div class="col-sm-3">
                <div class="d-flex, flex-column p-2">
                    <span>Customer</span>
                    <img src="@_ticket.CustomerImage" class="img-fluid w-100" alt="@_ticket.CustomerName">
                    <span>@_ticket.CustomerName</span>
                </div>
                
            </div>
            <div class="col-sm-6">
                <div class="card-text fw=bold">
                    <h6 class="card-text d-flex flex-column mt-4 fw-bold">
                        <small class="card-text">Title:</small>
                        <span>@_ticket.TicketTitle</span>
                    </h6>
                    
                    <p class="card-text d-flex flex-column mt-2">
                        <span>Description:</span>
                        <span>@_ticket.TicketDescription</span>
                        
                    </p>
                    <p class="card-text d-flex justify-content-between align-items-center">
                        <small class="text-body-secondary">Status</small>
                        <small class="text-body-secondary">@_ticket.Status</small>
                    </p>
                    <p class="card-text d-flex justify-content-between align-items-center">
                        <small class="text-body-secondary">Completed</small>
                        <small class="text-body-secondary">
                            @(_ticket.Completed ? (MarkupString)"<span class='text-success'>✔</span>" : (MarkupString)"<span class='text-danger'>✘</span>")
                        </small>
                    </p>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <button class="btn btn-link link-secondary link-hover-secondary text-decoration-none" @onclick="BackToList">Back</button>
                    <button class="btn btn-link link-danger link-hover-danger text-decoration-none" @onclick="PrepareDelete">Delete</button>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="d-flex flex-column p-2">
                    <span>Technician</span>
                    <img src="@_ticket.TechnicianImage" class="img-fluid" alt="@_ticket.TechnicianName">
                    <span>@_ticket.TechnicianName</span>
                </div>
                
            </div>
        </div>
    </div>
}
@if (_isModalOpen)
{
    <Modal ModalTitle="Delete Assigned Ticket Dialog" 
           ModalMessage="Do you want to delete this Customer?" 
           BtnMessage="Delete" 
           OnCancelClick="CloseModal"
           OnDeleteClick="ConfirmDelete">
    </Modal>
}


@code {
    [Parameter] public Guid TechId { get; set; }

    [Parameter] public Guid TicketId { get; set; }

    private bool _isModalOpen;

    private (Guid TechId, Guid TicketId ) _ticketIdToDelete;


    private AssignedTicketResponse? _ticket;

    protected override async Task OnInitializedAsync()
    {
        if (RendererInfo.IsInteractive)
        {
            _ticket ??= await TicketRepo.GetAssignedTicketById(TechId, TicketId);
        }
        
    }

    private void BackToList()
    {
        NavigationManager.NavigateTo("assign-tickets");

    }

    private void PrepareDelete()
    {
        _isModalOpen = true; // Open the modal
    }

    private void CloseModal()
    {
        _isModalOpen = false; // Close the modal
        _ticketIdToDelete = (Guid.Empty, Guid.Empty);
    }

    private async Task ConfirmDelete()
    {
        await TicketRepo.DeleteAssignedTicketById(_ticketIdToDelete.TechId, _ticketIdToDelete.TicketId);

        CloseModal(); // Reset state and close

        NavigationManager.NavigateTo("assign-tickets");
    }

}
