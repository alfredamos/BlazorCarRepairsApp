@inject NavigationManager NavManager
@implements IDisposable

<div class="dropdown">
    <button class="btn btn-link link-secondary dropdown-toggle text-decoration-none" 
            type="button" 
            @onclick="ToggleDropdown" 
            aria-expanded="@_isOpen.ToString().ToLower()">
        Settings
    </button>
    
    <ul class="dropdown-menu dropdown-menu-end text-center @(_isOpen ? "show" : "")" style="min-width: 160px; overflow: hidden;">
        <li class="w-100">
            <NavLink class="dropdown-item text-decoration-none mx-auto" href="account/manage" Match="NavLinkMatch.All">Profile</NavLink>
        </li>
        <li><hr class="dropdown-divider"></li>
        <li class="w-100">
            <NavLink class="dropdown-item text-decoration-none mx-auto" href="" Match="NavLinkMatch.All">Home</NavLink>
        </li>
        <li><hr class="dropdown-divider"></li>
        <li class="w-100">
            <button type="button" class="dropdown-item" @onclick="HandleLogout">Logout</button>
        </li>
    </ul>
</div>

@code {
    private bool _isOpen = false;

    protected override void OnInitialized()
    {
        // Hook into the routing engine to listen for page changes
        NavManager.LocationChanged += OnLocationChanged;
    }

    private void ToggleDropdown()
    {
        _isOpen = !_isOpen;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Close the menu when navigating and force Blazor to render the update
        _isOpen = false;
        StateHasChanged();
    }

    private void HandleLogout()
    {
        _isOpen = false;
    }

    public void Dispose()
    {
        // Unsubscribe from the event safely to avoid memory leaks
        NavManager.LocationChanged -= OnLocationChanged;
    }
}