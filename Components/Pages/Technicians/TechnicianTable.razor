@using BlazorCarRepairsApp.Dto.Technicians

<div class="card-header mt-2 mb-3">
    <h3 class="text-lg-center mb-2">List of Users</h3>
    <SearchBar @bind-Value:get="Value" @bind-Value:set="HandleSearchBarChanged"></SearchBar>
</div>
<!-- Responsive wrapper container -->
<div class="table-responsive">
    <table class="table table-striped align-middle"> 
        <thead> 
        <tr> 
            <th scope="col">Image</th> 
            <th scope="col">Name</th> 
            <th scope="col">Email</th> 
            <th scope="col">Phone</th> 
            <th scope="col">Birthdate</th> 
            <th scope="col">Gender</th> 
            <th scope="col">Specialty</th>
            <th scope="col" class="text-center">Action</th> 
        </tr> 
        </thead> 
        <tbody> 
        @foreach (var tech in Technicians) 
        { 
            <OneTechnician
                Technician="tech"
                OnDeleteTechnician="PrepareDelete"
                OnDetailTechnician="DetailTechnician"
                OnEditTechnician="UpdateTechnician"
                OnGetTechTickets="GetTechTickets"
            >
            </OneTechnician>
        } 
        </tbody> 
    </table> 
    <div class="d-flex justify-content-end align-content-center mb-5">
        <button type="button" class="btn btn-outline-secondary btn-lg" @onclick="CreateNewTechnician">Add new Technician</button>
    </div>
</div>

@if (_isModalOpen)
{
    <Modal ModalTitle="Delete Technician Dialog" 
           ModalMessage="Do you want to delete this technician?" 
           BtnMessage="Delete" 
           OnCancelClick="CloseModal"
           OnDeleteClick="ConfirmDelete">
    </Modal>
}

@code {
    [Parameter] public List<TechResponse> Technicians { get; set; } = [];
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<Guid> OnDetailTechnician { get; set; }
    [Parameter] public EventCallback<Guid> OnConfirmDelete { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public EventCallback OnCreateNewTechnician { get; set; }
    [Parameter] public EventCallback<Guid> OnEditTechnician {get; set; }
    [Parameter] public EventCallback<Guid> OnGetTechTickets {get; set; }


    private bool _isModalOpen;
    private Guid _technicianIdToDelete;
    
    private async Task DetailTechnician(Guid id)
    {
        await OnDetailTechnician.InvokeAsync(id);
    }

    private void PrepareDelete(Guid id)
    {
        _technicianIdToDelete = id;
        _isModalOpen = true; // Open the modal
    }

    private void CloseModal()
    {
        _isModalOpen = false; // Close the modal
        _technicianIdToDelete = Guid.Empty;
    }

    private async Task ConfirmDelete()
    {
        await OnConfirmDelete.InvokeAsync(_technicianIdToDelete);

        CloseModal(); // Reset state and close
    }

    private async Task CreateNewTechnician()
    {
        await OnCreateNewTechnician.InvokeAsync();
    }

    private async Task UpdateTechnician(Guid id)
    {
        await OnEditTechnician.InvokeAsync(id);
    }
    
    private async Task GetTechTickets(Guid technicianId)
    {
        await OnGetTechTickets.InvokeAsync(technicianId);
    }

    private async Task HandleSearchBarChanged(string newValue)
    {
        await ValueChanged.InvokeAsync(newValue);
    }

}