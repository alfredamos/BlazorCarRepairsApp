@page "/technicians/edit/{id:guid}"
@using BlazorCarRepairsApp.Dto.Technicians
@using BlazorCarRepairsApp.Filters
@inject ITechnicianRepo TechnicianRepo
@inject NavigationManager NavigationManager

@attribute [TechnicianOwnerOrAdmin]

<PageTitle>Technician Edit Form</PageTitle>

@if (_isLoading)
{
    <p>Loading technician edit form...</p>
}
else if (Technician is null)
{
    <p class="text-danger">Technician not found.</p>
    <button class="btn btn-secondary mt-2" @onclick="BackToList">Back to List</button>
}
else
{
    <div class="row">
        <div class="col-lg-6 mx-auto">
            <EditForm Model="Technician" method="post" OnValidSubmit="EditTechnicianForm" FormName="technicianEditForm">
                <DataAnnotationsValidator />
                <h2>Edit technician form.</h2>
                <hr />
                <ValidationSummary class="text-danger" role="alert" />
                
                <input @bind="Technician.Id" type="hidden" />
                <input @bind="Technician.UserId" type="hidden" />

                <div class="form-floating mb-3">
                    <InputText @bind-Value="Technician.Specialty" id="Technician.Specialty" class="form-control" autocomplete="specialty" aria-required="true" placeholder="Engineer" />
                    <label for="Technician.Specialty">Specialty</label>
                    <ValidationMessage For="() => Technician.Specialty" class="text-danger" />
                </div>

                <div class="d-flex flex-column align-content-center gap-2">
                    <button type="submit" class="w-100 btn btn-lg btn-primary">Edit</button>
                    <button type="button" class="w-100 btn btn-lg btn-secondary" @onclick="BackToList">Cancel</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromForm]
    public TechEditDto? Technician { get; set; }

    private TechResponse? _techResponse;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        if (RendererInfo.IsInteractive)
        {
            try
            {
                if (Technician is null)
                {
                    _techResponse = await TechnicianRepo.GetTechById(Id);
                    if (_techResponse is not null)
                    {
                        Technician = new TechEditDto
                        {
                            Id = _techResponse.Id,
                            Specialty = _techResponse.Specialty,
                            UserId = _techResponse.UserId
                        };
                    }
                }
            }
            finally
            {
                _isLoading = false;
            }
        }
    }

    private async Task EditTechnicianForm()
    {
        if (Technician is not null)
        {
            await TechnicianRepo.EditTechById(Id, Technician);
            NavigationManager.NavigateTo("/technicians");
        }
    }

    private void BackToList()
    {
        NavigationManager.NavigateTo("/technicians");
    }
}