@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>
    <main>
        <div class="top-row">
            <AuthorizeView>
                <Authorized>
                    <div class="d-flex justify-content-between align-items-center mx-5">
                        @if (context.User.IsInRole(Roles.Admin))
                        {
                            <Admin />
                        }
                        <Settings />
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="d-flex justify-content-between align-items-center mx-5">
                        <NavLink href="account/login" class="btn-link link-primary text-decoration-none link-hover-primary fw-bold">Login</NavLink>
                        <NavLink href="account/register" class="btn-link link-primary text-decoration-none link-hover-primary fw-bold">Register</NavLink>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
